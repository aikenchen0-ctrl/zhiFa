import React, { useEffect } from 'react';\nimport { useChatStore } from './stores/chatStore';\nimport { TopBar } from './components/layout/TopBar';\nimport { BottomBar } from './components/layout/BottomBar';\nimport { LeftSidebar } from './components/layout/LeftSidebar';\nimport { RightSidebar } from './components/layout/RightSidebar';\nimport { ChatArea } from './components/chat/ChatArea';\nimport { OverlayContainer } from './components/layout/OverlayContainer';\nimport { ConnectionLayer } from './components/layout/ConnectionLayer';\nimport { PopupLayer } from './components/layout/PopupLayer';\nimport { Chat, Message, User } from './types';\n\nfunction App() {\n  const { \n    sidebarCollapsed, \n    rightSidebarVisible,\n    onChatSelect\n  } = useChatStore();\n  \n  // Initialize mock data\n  useEffect(() => {\n    // Create mock users\n    const mockUsers: User[] = [\n      { id: '1', name: '张三', avatar: 'https://ui-avatars.com/api/?name=张三&background=0066cc&color=fff', status: 'online' },\n      { id: '2', name: '李四', avatar: 'https://ui-avatars.com/api/?name=李四&background=ff6b6b&color=fff', status: 'offline' },\n      { id: '3', name: '王五', avatar: 'https://ui-avatars.com/api/?name=王五&background=4ecdc4&color=fff', status: 'away' },\n      { id: '4', name: '赵六', avatar: 'https://ui-avatars.com/api/?name=赵六&background=45b7d1&color=fff', status: 'online' },\n    ];\n\n    // Create mock chats\n    const mockChats: Chat[] = [\n      {\n        id: 'chat_1',\n        name: '张三',\n        type: 'private',\n        participants: [mockUsers[0]],\n        unreadCount: 3,\n        avatar: mockUsers[0].avatar,\n        isOnline: true,\n        lastActivity: new Date(Date.now() - 1000 * 60 * 5), // 5 minutes ago\n        lastMessage: {\n          id: 'msg_1',\n          chatId: 'chat_1',\n          senderId: '1',\n          content: '你好，最近怎么样？',\n          timestamp: new Date(Date.now() - 1000 * 60 * 5),\n          type: 'text',\n          status: 'read'\n        }\n      },\n      {\n        id: 'chat_2',\n        name: '项目讨论组',\n        type: 'group',\n        participants: mockUsers,\n        unreadCount: 0,\n        avatar: 'https://ui-avatars.com/api/?name=项目讨论组&background=95a5a6&color=fff',\n        isOnline: true,\n        lastActivity: new Date(Date.now() - 1000 * 60 * 30), // 30 minutes ago\n        lastMessage: {\n          id: 'msg_2',\n          chatId: 'chat_2',\n          senderId: '2',\n          content: '明天的会议准备得怎么样了？',\n          timestamp: new Date(Date.now() - 1000 * 60 * 30),\n          type: 'text',\n          status: 'read'\n        }\n      },\n      {\n        id: 'chat_3',\n        name: '李四',\n        type: 'private',\n        participants: [mockUsers[1]],\n        unreadCount: 1,\n        avatar: mockUsers[1].avatar,\n        isOnline: false,\n        lastActivity: new Date(Date.now() - 1000 * 60 * 60 * 2), // 2 hours ago\n        lastMessage: {\n          id: 'msg_3',\n          chatId: 'chat_3',\n          senderId: '2',\n          content: '周末一起出去玩吗？',\n          timestamp: new Date(Date.now() - 1000 * 60 * 60 * 2),\n          type: 'text',\n          status: 'delivered'\n        }\n      },\n      {\n        id: 'chat_4',\n        name: '王五',\n        type: 'private',\n        participants: [mockUsers[2]],\n        unreadCount: 0,\n        avatar: mockUsers[2].avatar,\n        isOnline: false,\n        lastActivity: new Date(Date.now() - 1000 * 60 * 60 * 24), // 1 day ago\n        lastMessage: {\n          id: 'msg_4',\n          chatId: 'chat_4',\n          senderId: 'current_user',\n          content: '好的，明天见！',\n          timestamp: new Date(Date.now() - 1000 * 60 * 60 * 24),\n          type: 'text',\n          status: 'read'\n        }\n      }\n    ];\n\n    // Create mock messages for the first chat\n    const mockMessages: Message[] = [\n      {\n        id: 'msg_1_1',\n        chatId: 'chat_1',\n        senderId: '1',\n        content: '嗨！今天天气真不错呢',\n        timestamp: new Date(Date.now() - 1000 * 60 * 60 * 2), // 2 hours ago\n        type: 'text',\n        status: 'read'\n      },\n      {\n        id: 'msg_1_2',\n        chatId: 'chat_1',\n        senderId: 'current_user',\n        content: '是啊，正好适合出去走走',\n        timestamp: new Date(Date.now() - 1000 * 60 * 60 * 2 + 1000 * 60 * 5), // 1h55m ago\n        type: 'text',\n        status: 'read'\n      },\n      {\n        id: 'msg_1_3',\n        chatId: 'chat_1',\n        senderId: '1',\n        content: '你最近在忙什么？',\n        timestamp: new Date(Date.now() - 1000 * 60 * 60), // 1 hour ago\n        type: 'text',\n        status: 'read'\n      },\n      {\n        id: 'msg_1_4',\n        chatId: 'chat_1',\n        senderId: 'current_user',\n        content: '在学习React和TypeScript，准备做一个聊天应用',\n        timestamp: new Date(Date.now() - 1000 * 60 * 50), // 50 minutes ago\n        type: 'text',\n        status: 'read'\n      },\n      {\n        id: 'msg_1_5',\n        chatId: 'chat_1',\n        senderId: '1',\n        content: '哇，听起来很有趣！需要帮忙的话随时说',\n        timestamp: new Date(Date.now() - 1000 * 60 * 45), // 45 minutes ago\n        type: 'text',\n        status: 'read',\n        reactions: [\n          { emoji: '👍', users: ['current_user'], count: 1 }\n        ]\n      },\n      {\n        id: 'msg_1_6',\n        chatId: 'chat_1',\n        senderId: 'current_user',\n        content: '谢谢你！到时候一定会请教的',\n        timestamp: new Date(Date.now() - 1000 * 60 * 40), // 40 minutes ago\n        type: 'text',\n        status: 'read'\n      },\n      {\n        id: 'msg_1_7',\n        chatId: 'chat_1',\n        senderId: '1',\n        content: '你好，最近怎么样？',\n        timestamp: new Date(Date.now() - 1000 * 60 * 5), // 5 minutes ago\n        type: 'text',\n        status: 'delivered'\n      }\n    ];\n\n    // Update store with mock data\n    const store = useChatStore.getState();\n    store.chats = mockChats;\n    store.messages = {\n      'chat_1': mockMessages,\n      'chat_2': [],\n      'chat_3': [],\n      'chat_4': []\n    };\n    \n    // Select first chat by default\n    onChatSelect('chat_1');\n  }, [onChatSelect]);\n\n  return (\n    <div className=\"h-screen w-screen overflow-hidden bg-gray-100 flex flex-col\">\n      {/* Top Bar */}\n      <TopBar />\n      \n      {/* Main Content Area */}\n      <div className=\"flex-1 flex overflow-hidden\">\n        {/* Left Sidebar */}\n        <LeftSidebar collapsed={sidebarCollapsed} />\n        \n        {/* Chat Area */}\n        <div className=\"flex-1 flex flex-col overflow-hidden\">\n          <ChatArea className=\"flex-1\" />\n          <BottomBar />\n        </div>\n        \n        {/* Right Sidebar */}\n        {rightSidebarVisible && (\n          <RightSidebar visible={rightSidebarVisible} />\n        )}\n      </div>\n      \n      {/* Overlay Container */}\n      <OverlayContainer />\n      \n      {/* Connection Layer */}\n      <ConnectionLayer />\n      \n      {/* Popup Layer */}\n      <PopupLayer />\n    </div>\n  );\n}\n\nexport default App;