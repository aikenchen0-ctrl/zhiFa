{
  "name": "pixijs-v8-mobile-framework",
  "version": "1.0.0",
  "description": "PixiJS v8 mobile-optimized framework with comprehensive testing and debugging",
  "main": "src/core/Application.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:performance": "node tests/performance/benchmark.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "debug": "node --inspect-brk=0.0.0.0:9229 src/debug/inspector.js",
    "mobile-debug": "node src/debug/mobile-debugger.js",
    "serve": "http-server -p 3000 -c-1"
  },
  "dependencies": {
    "pixi.js": "^8.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "http-server": "^14.1.1",
    "puppeteer": "^21.11.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "ws": "^8.17.1"
  },
  "keywords": [
    "pixijs",
    "mobile",
    "webgl",
    "canvas",
    "performance",
    "testing"
  ],
  "author": "Development Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
